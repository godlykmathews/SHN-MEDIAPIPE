# Leave model names empty to select from installed models.
OLLAMA_MODEL=
OLLAMA_VISION_MODEL=
OLLAMA_TIMEOUT=240
# PLANT_DATA_DIR=/absolute/path/to/your/data
# PLANT_MODEL_DIR=/absolute/path/to/your/models
